map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name ${HTTPS_IP};

    # Renewal must remain reachable over HTTP, without a redirect.
    include /opt/everest-https/acme.conf;

    location / {
        return 308 https://${HTTPS_IP}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${HTTPS_IP};

    ssl_certificate /etc/letsencrypt/live/${HTTPS_IP}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${HTTPS_IP}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /opt/everest-https/app.conf;
}
