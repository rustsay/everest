# LLM
LLM_BASE_URL=http://your-llm-server:8080/v1
LLM_API_KEY=your-api-key
LLM_MODEL=google/gemma-4-26b-a4b-it
AGENT_STRATEGY=temperature

# БД (postgres сервис в docker-compose использует этот пароль)
POSTGRES_PASSWORD=postgres

# JWT — смени на случайную строку в продакшене
SECRET_KEY=change-me-to-a-random-secret-string

# Почта: коды при регистрации и для «Забыли пароль».
# Пока SMTP_HOST пуст, код пишется в лог backend: docker compose logs backend | grep "Код"
# Подтверждение почты при регистрации временно отключено. Для включения: EMAIL_CONFIRM=true
EMAIL_CONFIRM=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Админка (#admin): почты через запятую. Пусто - админки нет ни у кого
ADMIN_EMAILS=
# Дни в админке считаются по этому часовому поясу (часы от UTC, Москва +3)
STATS_UTC_OFFSET=3

# Push-уведомления. Работают только на сайте с https.
# Ключ можно не задавать: сервер создаст его сам и сохранит в uploads/vapid_private.pem.
# Если ключ поменять, все подписки перестанут работать, и уведомления придётся включать заново.
VAPID_PRIVATE_KEY=
# Контакт для сервисов уведомлений: mailto:почта или https://адрес сайта. Пусто - берётся SMTP_FROM
VAPID_SUBJECT=
# Время ежедневного напоминания, если ученик не указал своё время занятий
PUSH_REMIND_TIME=17:00
