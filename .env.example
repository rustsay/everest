# LLM
LLM_BASE_URL=http://your-llm-server:8080/v1
LLM_API_KEY=your-api-key
LLM_MODEL=google/gemma-4-26b-a4b-it
AGENT_STRATEGY=temperature

# БД (postgres сервис в docker-compose использует этот пароль)
POSTGRES_PASSWORD=postgres

# JWT — смени на случайную строку в продакшене
SECRET_KEY=change-me-to-a-random-secret-string
